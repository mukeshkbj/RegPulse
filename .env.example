# Nebius Token Factory (https://tokenfactory.nebius.com) — OpenAI-compatible
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs — confirm with `npm run check-models` and paste the exact IDs here
# Fast, high-volume triage (Nemotron Nano; nvidia/nemotron-3-super-120b-a12b also works)
TRIAGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Deep reasoning: impact mapping, tickets, chat (Nemotron Ultra)
REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Prices in USD per 1M tokens, used for the cost telemetry panel
TRIAGE_PRICE_IN=0.06
TRIAGE_PRICE_OUT=0.24
REASONING_PRICE_IN=1.00
REASONING_PRICE_OUT=3.00

# Tavily (https://tavily.com) — live regulator search and extraction
TAVILY_API_KEY=

# Save each completed live sweep to data/demo-run.json (local dev only)
RECORD_RUNS=1

# ElevenLabs (optional) — only for generating the demo video voiceover: npm run voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
